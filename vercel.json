{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd website && npm install && npm run build",
  "outputDirectory": "website/dist",
  "framework": "vite",
  "redirects": [
    {
      "source": "/app",
      "destination": "/app/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/app/",
      "destination": "/simulator/index.html"
    },
    {
      "source": "/app/((?:css|js|assets|data)/.*)",
      "destination": "/simulator/$1"
    },
    {
      "source": "/app/(manifest\\.webmanifest|manifest\\.json|sw\\.js|favicon\\.svg|404\\.html|dropdown\\.js)",
      "destination": "/simulator/$1"
    },
    {
      "source": "/app/(.*)",
      "destination": "/simulator/index.html"
    },
    {
      "source": "/simulator",
      "destination": "/simulator/index.html"
    },
    {
      "source": "/simulator/",
      "destination": "/simulator/index.html"
    },
    {
      "source": "/simulator/(.*)",
      "destination": "/simulator/$1"
    },
    {
      "source": "/((?!app|simulator).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(app|simulator)/manifest.webmanifest",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json; charset=utf-8" }
      ]
    },
    {
      "source": "/(app|simulator)/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/simulator/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors *" }
      ]
    },
    {
      "source": "/((?!simulator).*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
